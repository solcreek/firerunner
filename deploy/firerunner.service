[Unit]
Description=firerunner - ephemeral Firecracker microVM GitHub Actions runners
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/firerunner/firerunner.env
ExecStart=/usr/local/bin/firerunner
Restart=on-failure
RestartSec=5

# Graceful shutdown: firerunner cancels its context on SIGTERM, stops accepting
# work, and drains in-flight microVMs before exiting. Give it long enough to let
# a running job finish; otherwise systemd's default stop timeout SIGKILLs the
# listener mid-job and orphans firecracker children (which leak tap devices).
# Tune to your longest expected job.
KillSignal=SIGTERM
TimeoutStopSec=1h

# The process needs KVM and network/tap management. Run as a dedicated,
# non-login user with only the capabilities it requires.
User=firerunner
Group=firerunner
SupplementaryGroups=kvm
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN

# Hardening.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/tmp/firerunner /var/log/firerunner
# ip_forward must be writable to enable microVM egress; firerunner sets it at
# startup, so kernel tunables cannot be fully protected.
ProtectKernelTunables=false
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
# PrivateTmp is intentionally disabled: the work dir must sit on a reflink-
# capable filesystem (btrfs/XFS), not the tmpfs that PrivateTmp would provide.

[Install]
WantedBy=multi-user.target
