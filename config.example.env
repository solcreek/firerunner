# firerunner configuration (environment form). Flags of the same name override.
# Copy to /etc/firerunner/firerunner.env and edit.

# --- GitHub scale set ---
FR_URL=https://github.com/ORG/REPO
FR_NAME=firerunner
FR_RUNNER_GROUP=default
FR_LABELS=
FR_MAX_RUNNERS=4
FR_MIN_RUNNERS=0

# --- Auth (prefer a GitHub App over a PAT) ---
# FR_TOKEN=ghp_...
FR_APP_CLIENT_ID=
FR_APP_INSTALLATION_ID=
FR_APP_PRIVATE_KEY=/etc/firerunner/app-key.pem

# --- microVM shape ---
FR_VCPU=4
FR_MEM_MIB=8192

# --- Firecracker ---
FR_FIRECRACKER_BIN=firecracker
FR_KERNEL=/var/lib/firerunner/vmlinux
FR_GOLDEN=/var/lib/firerunner/golden.ext4
FR_WORKDIR=/var/tmp/firerunner

# --- logging ---
FR_LOG_LEVEL=info
FR_LOG_FORMAT=text
